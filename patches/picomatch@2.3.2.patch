+// A plain star can absorb further repetitions of its branch. More complex
+// branches use the existing literal fallback rather than a nested quantifier.
+const isSelfRepeatingStarBranch = branch => {
+  return branch.includes('*') &&
+    !branch.includes('**') &&
+    !/[\\/"?()[\]{}|!+@]/.test(branch);
+};
